<Window x:Class="GeniaText.RecoveryCenterWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Восстановление — GeniaText" Width="920" Height="600"
        MinWidth="800" MinHeight="500" WindowStartupLocation="CenterOwner"
        Background="{StaticResource WindowBackground}"
        Icon="pack://application:,,,/Assets/GeniaText.ico">
    <Grid Margin="16,14,16,14">
        <Grid.RowDefinitions>
            <RowDefinition Height="58"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="44"/>
        </Grid.RowDefinitions>

        <StackPanel Grid.Row="0">
            <TextBlock Text="Восстановление" FontSize="20" FontWeight="SemiBold"/>
            <TextBlock Text="Подключаемые инструменты редактора. Основное окно выбора фраз от них не зависит."
                       Margin="0,3,0,0" FontSize="11.5" Foreground="{StaticResource TextSecondary}"/>
        </StackPanel>

        <TabControl x:Name="RecoveryTabs" Grid.Row="1" Background="White"
                    SelectionChanged="RecoveryTabs_SelectionChanged"
                    BorderBrush="{StaticResource Win7TabBorderBrush}">
            <TabItem x:Name="TrashTab" Header="Корзина">
                <Grid Margin="12">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="46"/>
                    </Grid.RowDefinitions>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="330"/>
                        <ColumnDefinition Width="12"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>

                    <Grid Grid.Row="0" Grid.Column="0">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="25"/>
                            <RowDefinition Height="*"/>
                        </Grid.RowDefinitions>
                        <TextBlock x:Name="TrashCountText" FontWeight="SemiBold" VerticalAlignment="Top"/>
                        <ListBox x:Name="TrashList" Grid.Row="1" Style="{StaticResource Win7ListBox}">
                            <ListBox.Resources>
                                <Style TargetType="ListBoxItem">
                                    <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
                                    <Setter Property="Padding" Value="9,6"/>
                                    <Setter Property="BorderBrush" Value="{StaticResource Win7SeparatorBrush}"/>
                                    <Setter Property="BorderThickness" Value="0,0,0,1"/>
                                </Style>
                            </ListBox.Resources>
                            <ListBox.ItemTemplate>
                                <DataTemplate>
                                    <StackPanel>
                                        <TextBlock Text="{Binding DisplayTitle}" TextTrimming="CharacterEllipsis"/>
                                        <TextBlock Text="{Binding DeletedAt, StringFormat={}{0:g}}" Margin="0,2,0,0"
                                                   FontSize="10.5" Foreground="{StaticResource TextSecondary}"/>
                                    </StackPanel>
                                </DataTemplate>
                            </ListBox.ItemTemplate>
                        </ListBox>
                    </Grid>

                    <Border Grid.Row="0" Grid.Column="2" Background="White"
                            BorderBrush="{StaticResource BorderBrushSoft}" BorderThickness="1" Padding="14">
                        <Grid DataContext="{Binding SelectedItem, ElementName=TrashList}">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="7"/>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="7"/>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="*"/>
                            </Grid.RowDefinitions>
                            <TextBlock Grid.Row="0" Text="Название" FontWeight="SemiBold" Margin="0,0,0,3"/>
                            <Border Grid.Row="1" MinHeight="30" MaxHeight="64" Padding="5,4" Background="White"
                                    BorderBrush="{StaticResource Win7ControlBorderBrush}" BorderThickness="1"
                                    SnapsToDevicePixels="True" ToolTip="{Binding Phrase.Title}">
                                <TextBlock Text="{Binding Phrase.Title}" TextWrapping="Wrap" VerticalAlignment="Center"/>
                            </Border>
                            <TextBlock Grid.Row="3" Text="Категория" FontWeight="SemiBold" Margin="0,0,0,3"/>
                            <Border Grid.Row="4" MinHeight="30" MaxHeight="64" Padding="5,4" Background="White"
                                    BorderBrush="{StaticResource Win7ControlBorderBrush}" BorderThickness="1"
                                    SnapsToDevicePixels="True" ToolTip="{Binding Phrase.Category}">
                                <TextBlock Text="{Binding Phrase.Category}" TextWrapping="Wrap" VerticalAlignment="Center"/>
                            </Border>
                            <TextBlock Grid.Row="6" Text="Текст фразы" FontWeight="SemiBold" Margin="0,0,0,3"/>
                            <TextBox Grid.Row="7" Text="{Binding Phrase.Text, Mode=OneWay}" IsReadOnly="True" AcceptsReturn="True"
                                     TextWrapping="Wrap" VerticalContentAlignment="Top"
                                     VerticalScrollBarVisibility="Auto" Style="{StaticResource EditorTextBox}"/>
                        </Grid>
                    </Border>

                    <StackPanel Grid.Row="1" Grid.Column="0" Grid.ColumnSpan="3" Orientation="Horizontal"
                                HorizontalAlignment="Right" VerticalAlignment="Bottom">
                        <Button Style="{StaticResource DefaultButton}" Content="Очистить корзину" MinWidth="116"
                                Margin="0,0,7,0" Click="EmptyTrash_Click"/>
                        <Button Style="{StaticResource DefaultButton}" Content="Удалить навсегда" MinWidth="120"
                                Margin="0,0,7,0" Click="DeleteTrash_Click"/>
                        <Button Style="{StaticResource PrimaryButton}" Content="Восстановить" MinWidth="104"
                                Click="RestoreTrash_Click"/>
                    </StackPanel>
                </Grid>
            </TabItem>

            <TabItem x:Name="BackupsTab" Header="Резервные копии">
                <Grid Margin="12">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="46"/>
                    </Grid.RowDefinitions>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="300"/>
                        <ColumnDefinition Width="12"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>

                    <Grid Grid.Row="0" Grid.Column="0">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="25"/>
                            <RowDefinition Height="*"/>
                        </Grid.RowDefinitions>
                        <TextBlock x:Name="BackupCountText" FontWeight="SemiBold"/>
                        <ListBox x:Name="BackupList" Grid.Row="1" Style="{StaticResource Win7ListBox}"
                                 SelectionChanged="BackupList_SelectionChanged">
                            <ListBox.Resources>
                                <Style TargetType="ListBoxItem">
                                    <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
                                    <Setter Property="Padding" Value="9,6"/>
                                    <Setter Property="BorderBrush" Value="{StaticResource Win7SeparatorBrush}"/>
                                    <Setter Property="BorderThickness" Value="0,0,0,1"/>
                                </Style>
                            </ListBox.Resources>
                            <ListBox.ItemTemplate>
                                <DataTemplate>
                                    <StackPanel>
                                        <TextBlock Text="{Binding CreatedAtLabel, Mode=OneWay}" FontWeight="SemiBold"/>
                                        <TextBlock Margin="0,2,0,0" FontSize="10.5" Foreground="{StaticResource TextSecondary}">
                                            <Run Text="{Binding Reason, Mode=OneWay}"/><Run Text=" · "/><Run Text="{Binding SizeLabel, Mode=OneWay}"/>
                                        </TextBlock>
                                    </StackPanel>
                                </DataTemplate>
                            </ListBox.ItemTemplate>
                        </ListBox>
                    </Grid>

                    <Grid Grid.Row="0" Grid.Column="2">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="25"/>
                            <RowDefinition Height="*"/>
                            <RowDefinition Height="110"/>
                        </Grid.RowDefinitions>
                        <TextBlock x:Name="SnapshotSummaryText" FontWeight="SemiBold"/>
                        <ListBox x:Name="BackupPhraseList" Grid.Row="1" Style="{StaticResource Win7ListBox}">
                            <ListBox.Resources>
                                <Style TargetType="ListBoxItem">
                                    <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
                                    <Setter Property="Padding" Value="9,6"/>
                                    <Setter Property="BorderBrush" Value="{StaticResource Win7SeparatorBrush}"/>
                                    <Setter Property="BorderThickness" Value="0,0,0,1"/>
                                </Style>
                            </ListBox.Resources>
                            <ListBox.ItemTemplate>
                                <DataTemplate>
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="150"/>
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Grid.Column="0" Text="{Binding DisplayTitle}" TextTrimming="CharacterEllipsis" Margin="0,0,10,0"/>
                                        <TextBlock Grid.Column="1" Text="{Binding Category}" TextTrimming="CharacterEllipsis"
                                                   Foreground="{StaticResource TextSecondary}"/>
                                    </Grid>
                                </DataTemplate>
                            </ListBox.ItemTemplate>
                        </ListBox>
                        <TextBox Grid.Row="2" Margin="0,8,0,0"
                                 Text="{Binding SelectedItem.Text, ElementName=BackupPhraseList, Mode=OneWay}"
                                 IsReadOnly="True" AcceptsReturn="True" TextWrapping="Wrap" VerticalContentAlignment="Top"
                                 VerticalScrollBarVisibility="Auto" Style="{StaticResource EditorTextBox}"/>
                    </Grid>

                    <StackPanel Grid.Row="1" Grid.Column="0" Grid.ColumnSpan="3" Orientation="Horizontal"
                                HorizontalAlignment="Right" VerticalAlignment="Bottom">
                        <Button x:Name="DeleteBackupButton" Style="{StaticResource DefaultButton}" Content="Удалить копию" MinWidth="108"
                                Margin="0,0,16,0" IsEnabled="False" Click="DeleteBackup_Click"/>
                        <Button Style="{StaticResource DefaultButton}" Content="Вернуть выбранную" MinWidth="124"
                                Margin="0,0,7,0" Click="RestoreSelectedPhrase_Click"/>
                        <Button Style="{StaticResource DefaultButton}" Content="Объединить с текущими" MinWidth="152"
                                Margin="0,0,7,0" Click="AppendSnapshot_Click"/>
                        <Button Style="{StaticResource PrimaryButton}" Content="Заменить текущие" MinWidth="126"
                                Click="ReplaceSnapshot_Click"/>
                    </StackPanel>
                </Grid>
            </TabItem>
        </TabControl>

        <Button Grid.Row="2" Style="{StaticResource DefaultButton}" Content="Закрыть" MinWidth="86"
                HorizontalAlignment="Right" VerticalAlignment="Bottom" Click="Close_Click"/>
    </Grid>
</Window>
