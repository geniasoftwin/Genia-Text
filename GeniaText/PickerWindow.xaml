<Window x:Class="GeniaText.PickerWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="GeniaText" Width="680" Height="520"
        MinWidth="520" MinHeight="390"
        ResizeMode="CanResizeWithGrip" ShowInTaskbar="False"
        Icon="pack://application:,,,/Assets/GeniaText.ico"
        PreviewKeyDown="Window_PreviewKeyDown" Deactivated="Window_Deactivated">
    <Window.Resources>
        <!-- Picker-only sizing keeps the search and filter optically aligned
             without changing text fields in the editor or settings windows. -->
        <Style x:Key="PickerSearchBoxStyle" TargetType="TextBox"
               BasedOn="{StaticResource EditorTextBox}">
            <Setter Property="Height" Value="34"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
            <Setter Property="SnapsToDevicePixels" Value="True"/>
        </Style>

        <Style x:Key="PickerFilterItemStyle" TargetType="ComboBoxItem"
               BasedOn="{StaticResource Win7ComboBoxItemStyle}">
            <Setter Property="MinHeight" Value="27"/>
            <Setter Property="Padding" Value="8,1,8,0"/>
            <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
            <Setter Property="SnapsToDevicePixels" Value="True"/>
        </Style>

        <Style x:Key="PickerFilterBoxStyle" TargetType="ComboBox"
               BasedOn="{StaticResource EditorComboBox}">
            <Setter Property="Height" Value="34"/>
            <Setter Property="Padding" Value="6,1,6,0"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
            <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
            <Setter Property="ItemContainerStyle" Value="{StaticResource PickerFilterItemStyle}"/>
            <Setter Property="SnapsToDevicePixels" Value="True"/>
        </Style>
    </Window.Resources>

    <Grid Margin="14,12,14,12">
            <Grid.RowDefinitions>
                <RowDefinition Height="46"/>
                <RowDefinition Height="34"/>
                <RowDefinition Height="8"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="44"/>
            </Grid.RowDefinitions>

            <Grid Grid.Row="0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="38"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <Grid Grid.Column="0" Grid.ColumnSpan="2">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="38"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <Image Grid.Column="0" Width="32" Height="32"
                           HorizontalAlignment="Left" VerticalAlignment="Top" SnapsToDevicePixels="True"
                           RenderOptions.BitmapScalingMode="HighQuality">
                        <Image.Source>
                            <BitmapImage UriSource="pack://application:,,,/Assets/GeniaText.png"
                                         DecodePixelWidth="32" CacheOption="OnLoad"/>
                        </Image.Source>
                    </Image>
                    <StackPanel Grid.Column="1" Margin="5,0,0,0">
                        <TextBlock Text="GeniaText" FontSize="18" FontWeight="SemiBold"/>
                        <TextBlock Text="Выберите фразу и нажмите Enter или Space" FontSize="11" Margin="0,2,0,0"
                                   Foreground="{StaticResource TextSecondary}"/>
                    </StackPanel>
                </Grid>

                <Button Grid.Column="2" Style="{StaticResource DefaultButton}" Content="Фразы"
                        ClickMode="Press" MinWidth="84" Padding="10,5" Height="32"
                        VerticalAlignment="Top" Click="Editor_Click"/>
            </Grid>

            <Grid Grid.Row="1">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="10"/>
                    <ColumnDefinition Width="170"/>
                </Grid.ColumnDefinitions>
                <TextBox x:Name="SearchBox" Grid.Column="0" Style="{StaticResource PickerSearchBoxStyle}"
                         TextChanged="SearchBox_TextChanged"/>
                <ComboBox x:Name="FilterBox" Grid.Column="2" Style="{StaticResource PickerFilterBoxStyle}"
                          DisplayMemberPath="Label" SelectionChanged="FilterBox_SelectionChanged"/>
            </Grid>

            <Grid Grid.Row="3">
                <ListBox x:Name="PhraseList" Style="{StaticResource Win7ListBox}"
                         VirtualizingPanel.IsVirtualizing="True" VirtualizingPanel.VirtualizationMode="Recycling"
                         ScrollViewer.CanContentScroll="True" ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                         MouseDoubleClick="PhraseList_MouseDoubleClick">
                    <ListBox.Resources>
                        <Style TargetType="ListBoxItem">
                            <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
                            <Setter Property="Padding" Value="0"/>
                            <Setter Property="Margin" Value="0"/>
                            <Setter Property="Background" Value="White"/>
                            <Setter Property="BorderBrush" Value="{StaticResource Win7SeparatorBrush}"/>
                            <Setter Property="BorderThickness" Value="0,0,0,1"/>
                            <Setter Property="Template">
                                <Setter.Value>
                                    <ControlTemplate TargetType="ListBoxItem">
                                        <Border x:Name="ItemBorder" Background="{TemplateBinding Background}"
                                                BorderBrush="{TemplateBinding BorderBrush}"
                                                BorderThickness="{TemplateBinding BorderThickness}"
                                                Padding="11,7">
                                            <ContentPresenter/>
                                        </Border>
                                        <ControlTemplate.Triggers>
                                            <Trigger Property="IsMouseOver" Value="True">
                                                <Setter TargetName="ItemBorder" Property="Background" Value="{StaticResource Win7HoverBrush}"/>
                                                <Setter TargetName="ItemBorder" Property="BorderBrush" Value="{StaticResource Win7HoverBorderBrush}"/>
                                            </Trigger>
                                            <Trigger Property="IsSelected" Value="True">
                                                <Setter TargetName="ItemBorder" Property="Background" Value="{StaticResource Win7SelectionBrush}"/>
                                                <Setter TargetName="ItemBorder" Property="BorderBrush" Value="{StaticResource Win7SelectionBorderBrush}"/>
                                            </Trigger>
                                        </ControlTemplate.Triggers>
                                    </ControlTemplate>
                                </Setter.Value>
                            </Setter>
                        </Style>
                    </ListBox.Resources>
                    <ListBox.ItemTemplate>
                        <DataTemplate>
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <TextBlock Text="{Binding DisplayTitle}" FontSize="12" TextTrimming="CharacterEllipsis"
                                           Foreground="{StaticResource TextPrimary}"/>
                                <TextBlock Grid.Column="1" Text="★" Foreground="#D79000" Margin="10,0,0,0">
                                    <TextBlock.Style>
                                        <Style TargetType="TextBlock">
                                            <Setter Property="Visibility" Value="Collapsed"/>
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding IsFavorite}" Value="True">
                                                    <Setter Property="Visibility" Value="Visible"/>
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </TextBlock.Style>
                                </TextBlock>
                            </Grid>
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                </ListBox>
                <TextBlock x:Name="EmptyMessage" Text="Фразы не найдены" FontSize="12.5"
                           Foreground="{StaticResource TextSecondary}" HorizontalAlignment="Center"
                           VerticalAlignment="Center" Visibility="Collapsed"/>
            </Grid>

            <Grid Grid.Row="4" VerticalAlignment="Bottom">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <TextBlock VerticalAlignment="Center" FontSize="11" Foreground="{StaticResource TextSecondary}"
                           Text="↑↓ — выбор   Enter / Space — вставить   Esc — закрыть"/>
                <Button Grid.Column="1" Style="{StaticResource PrimaryButton}" Content="Вставить"
                        MinWidth="90" Height="32" Padding="12,5" Click="Insert_Click"/>
            </Grid>
    </Grid>
</Window>
