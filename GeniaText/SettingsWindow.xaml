<Window x:Class="GeniaText.SettingsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Настройки — GeniaText" Width="650" Height="690"
        MinWidth="650" MinHeight="620" ResizeMode="CanResize"
        WindowStartupLocation="CenterOwner"
        Background="{StaticResource WindowBackground}"
        Icon="pack://application:,,,/Assets/GeniaText.ico">
    <Grid Margin="20,16,20,16">
        <Grid.RowDefinitions>
            <RowDefinition Height="58"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="46"/>
        </Grid.RowDefinitions>

        <StackPanel Grid.Row="0">
            <TextBlock Text="Настройки GeniaText" FontSize="20" FontWeight="SemiBold"/>
            <TextBlock Text="Основной быстрый сценарий остается прежним. Дополнительные модули включаются отдельно."
                       FontSize="11.5" Margin="0,3,0,0" Foreground="{StaticResource TextSecondary}"/>
        </StackPanel>

        <TabControl Grid.Row="1" Background="{StaticResource SurfaceBrush}" BorderBrush="{StaticResource Win7TabBorderBrush}">
            <TabItem Header="Основные">
                <Grid Margin="18">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="82"/>
                        <RowDefinition Height="96"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>

                    <Grid Grid.Row="0">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="22"/>
                            <RowDefinition Height="32"/>
                            <RowDefinition Height="22"/>
                        </Grid.RowDefinitions>
                        <TextBlock Grid.Row="0" Text="Горячая клавиша открытия" FontSize="11.5" FontWeight="SemiBold"/>
                        <Grid Grid.Row="1">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="12"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <ComboBox x:Name="ModifierBox" Grid.Column="0" Style="{StaticResource EditorComboBox}" DisplayMemberPath="Label"/>
                            <ComboBox x:Name="KeyBox" Grid.Column="2" Style="{StaticResource EditorComboBox}" DisplayMemberPath="Label"/>
                        </Grid>
                        <TextBlock Grid.Row="2" FontSize="11" Foreground="{StaticResource TextSecondary}" Text="По умолчанию: Ctrl+Space"/>
                    </Grid>

                    <Border Grid.Row="1" Margin="0,5,0,0" Background="White" BorderBrush="{StaticResource BorderBrushSoft}"
                            BorderThickness="1" CornerRadius="0" Padding="12,10">
                        <StackPanel>
                            <CheckBox x:Name="PortableModeCheckBox" Content="Портативный режим" FontWeight="SemiBold"/>
                            <TextBlock Margin="19,6,0,0" FontSize="11" Foreground="{StaticResource TextSecondary}" TextWrapping="Wrap">
                                <Run Text="Фразы, настройки, резервные копии и журнал хранятся рядом с GeniaText.exe."/>
                                <LineBreak/>
                                <Run Text="Изменение применяется после перезапуска."/>
                            </TextBlock>
                        </StackPanel>
                    </Border>

                    <Border Grid.Row="2" Margin="0,12,0,0" Background="{StaticResource Win7SubtlePanelBrush}" BorderBrush="{StaticResource BorderBrushSoft}"
                            BorderThickness="1" CornerRadius="0" Padding="12,10" VerticalAlignment="Top">
                        <TextBlock Foreground="{StaticResource TextSecondary}" FontSize="11" TextWrapping="Wrap">
                            Все дополнительные возможности на соседней вкладке по умолчанию выключены. Если их не включать,
                            GeniaText работает по тому же базовому сценарию: Ctrl+Space → выбор фразы → Enter/Space.
                        </TextBlock>
                    </Border>
                </Grid>
            </TabItem>

            <TabItem Header="Возможности">
                <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                    <StackPanel Margin="18,14,18,18">
                        <TextBlock Text="Подключаемые модули" FontSize="14" FontWeight="SemiBold" Margin="0,0,0,3"/>
                        <TextBlock Text="Выключенный модуль не участвует в основном сценарии работы."
                                   Foreground="{StaticResource TextSecondary}" FontSize="11" Margin="0,0,0,12"/>

                        <Border Background="White" BorderBrush="{StaticResource BorderBrushSoft}" BorderThickness="1" CornerRadius="0" Padding="12" Margin="0,0,0,8">
                            <StackPanel>
                                <CheckBox x:Name="EditorProCheckBox" Content="Редактор Pro" FontWeight="SemiBold"/>
                                <TextBlock Margin="19,5,0,0" Foreground="{StaticResource TextSecondary}" FontSize="11" TextWrapping="Wrap"
                                           Text="Отдельное окно для пакетной смены категории, управления избранным и безопасного поиска повторяющихся фраз."/>
                            </StackPanel>
                        </Border>

                        <Border Background="White" BorderBrush="{StaticResource BorderBrushSoft}" BorderThickness="1" CornerRadius="0" Padding="12" Margin="0,0,0,8">
                            <StackPanel>
                                <CheckBox x:Name="SmartTemplatesCheckBox" Content="Умные шаблоны" FontWeight="SemiBold"/>
                                <TextBlock Margin="19,5,0,0" Foreground="{StaticResource TextSecondary}" FontSize="11" TextWrapping="Wrap"
                                           Text="Подстановка {date}, {time} и {datetime} непосредственно перед вставкой. Неизвестные конструкции остаются без изменений."/>
                            </StackPanel>
                        </Border>

                        <Border Background="White" BorderBrush="{StaticResource BorderBrushSoft}" BorderThickness="1" CornerRadius="0" Padding="12" Margin="0,0,0,8">
                            <StackPanel>
                                <CheckBox x:Name="AdvancedSearchCheckBox" Content="Расширенный поиск" FontWeight="SemiBold"/>
                                <TextBlock Margin="19,5,0,0" Foreground="{StaticResource TextSecondary}" FontSize="11" TextWrapping="Wrap"
                                           Text="Поиск по нескольким словам и осторожная коррекция небольших опечаток в названии, категории и тексте."/>
                            </StackPanel>
                        </Border>

                        <Border Background="White" BorderBrush="{StaticResource BorderBrushSoft}" BorderThickness="1" CornerRadius="0" Padding="12" Margin="0,0,0,8">
                            <StackPanel>
                                <CheckBox x:Name="UsageHistoryCheckBox" Content="История использования" FontWeight="SemiBold"/>
                                <TextBlock Margin="19,5,0,0" Foreground="{StaticResource TextSecondary}" FontSize="11" TextWrapping="Wrap"
                                           Text="Запоминает только локально время и количество успешных вставок и добавляет фильтр «Недавние»."/>
                            </StackPanel>
                        </Border>

                        <Border Background="White" BorderBrush="{StaticResource BorderBrushSoft}" BorderThickness="1" CornerRadius="0" Padding="12" Margin="0,0,0,8">
                            <StackPanel>
                                <CheckBox x:Name="AppProfilesCheckBox" Content="Профили приложений" FontWeight="SemiBold"/>
                                <TextBlock Margin="19,5,0,0" Foreground="{StaticResource TextSecondary}" FontSize="11" TextWrapping="Wrap"
                                           Text="При открытии окна выбора фраз автоматически выбирает категорию для приложения, из которого был вызван GeniaText."/>
                                <TextBlock Margin="19,8,0,4" FontSize="11" FontWeight="SemiBold" Text="Правила: process=категория"/>
                                <TextBox x:Name="AppProfileRulesBox" Margin="19,0,0,0" Height="70" AcceptsReturn="True" MaxLength="32768"
                                         VerticalScrollBarVisibility="Auto" VerticalContentAlignment="Top" Style="{StaticResource EditorTextBox}"
                                         IsEnabled="{Binding IsChecked, ElementName=AppProfilesCheckBox}"
                                         ToolTip="Пример: chrome=Web&#x0a;telegram=Telegram"/>
                            </StackPanel>
                        </Border>

                        <Border Background="White" BorderBrush="{StaticResource BorderBrushSoft}" BorderThickness="1" CornerRadius="0" Padding="12" Margin="0,0,0,8">
                            <StackPanel>
                                <CheckBox x:Name="CompatibilityModeCheckBox" Content="Расширенная совместимость вставки" FontWeight="SemiBold"/>
                                <TextBlock Margin="19,5,0,0" Foreground="{StaticResource TextSecondary}" FontSize="11" TextWrapping="Wrap"
                                           Text="Добавляет дополнительную попытку вернуть фокус перед Ctrl+V. Включайте только если стандартная вставка нестабильна в конкретной программе."/>
                            </StackPanel>
                        </Border>

                        <Border Background="White" BorderBrush="{StaticResource BorderBrushSoft}" BorderThickness="1" CornerRadius="0" Padding="12" Margin="0,0,0,8">
                            <StackPanel>
                                <CheckBox x:Name="AdvancedBackupsCheckBox" Content="Расширенные резервные копии" FontWeight="SemiBold"/>
                                <TextBlock Margin="19,5,0,0" Foreground="{StaticResource TextSecondary}" FontSize="11" TextWrapping="Wrap"
                                           Text="Во время изменений делает периодическую копию phrases.json не чаще одного раза в 10 минут и хранит до 30 копий."/>
                            </StackPanel>
                        </Border>

                        <Border Background="White" BorderBrush="{StaticResource BorderBrushSoft}" BorderThickness="1" CornerRadius="0" Padding="12" Margin="0,0,0,8">
                            <StackPanel>
                                <CheckBox x:Name="RecycleBinCheckBox" Content="Корзина удалённых фраз" FontWeight="SemiBold"/>
                                <TextBlock Margin="19,5,0,0" Foreground="{StaticResource TextSecondary}" FontSize="11" TextWrapping="Wrap"
                                           Text="Удаление из редактора сначала сохраняет локальную копию фразы в корзине. Восстановление открывается отдельной кнопкой."/>
                            </StackPanel>
                        </Border>

                        <Border Background="White" BorderBrush="{StaticResource BorderBrushSoft}" BorderThickness="1" CornerRadius="0" Padding="12" Margin="0,0,0,8">
                            <StackPanel>
                                <CheckBox x:Name="BackupBrowserCheckBox" Content="Просмотр резервных копий" FontWeight="SemiBold"/>
                                <TextBlock Margin="19,5,0,0" Foreground="{StaticResource TextSecondary}" FontSize="11" TextWrapping="Wrap"
                                           Text="Показывает локальные копии из папки Backups, позволяет восстановить фразу или всю копию и удалить выбранную копию. В обычном режиме хранится до 10 копий; при расширенном — до 30."/>
                            </StackPanel>
                        </Border>

                        <Border Background="White" BorderBrush="{StaticResource BorderBrushSoft}" BorderThickness="1" CornerRadius="0" Padding="12">
                            <StackPanel>
                                <CheckBox x:Name="ImportPreviewCheckBox" Content="Безопасный предпросмотр импорта" FontWeight="SemiBold"/>
                                <TextBlock Margin="19,5,0,0" Foreground="{StaticResource TextSecondary}" FontSize="11" TextWrapping="Wrap"
                                           Text="Перед импортом показывает новые фразы, точные повторы и конфликты ID. До подтверждения база не меняется."/>
                            </StackPanel>
                        </Border>
                    </StackPanel>
                </ScrollViewer>
            </TabItem>
        </TabControl>

        <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Bottom">
            <Button Style="{StaticResource DefaultButton}" Content="Отмена" MinWidth="82" Padding="12,5" Margin="0,0,7,0" Click="Cancel_Click"/>
            <Button Style="{StaticResource PrimaryButton}" Content="Сохранить" MinWidth="96" Padding="12,5" Click="Save_Click"/>
        </StackPanel>
    </Grid>
</Window>
