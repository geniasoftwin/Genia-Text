<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:shell="clr-namespace:System.Windows.Shell;assembly=PresentationFramework"
                    xmlns:win="clr-namespace:System.Windows;assembly=PresentationFramework">
    <!-- Windows 7-inspired desktop palette. -->
    <SolidColorBrush x:Key="WindowBackground" Color="#F0F0F0"/>
    <SolidColorBrush x:Key="SurfaceBrush" Color="#FFFFFF"/>
    <SolidColorBrush x:Key="BorderBrushSoft" Color="#B8B8B8"/>
    <SolidColorBrush x:Key="TextPrimary" Color="#1E1E1E"/>
    <SolidColorBrush x:Key="TextSecondary" Color="#5C6470"/>
    <SolidColorBrush x:Key="AccentBrush" Color="#2A72C4"/>
    <SolidColorBrush x:Key="Win7ControlBorderBrush" Color="#707070"/>
    <SolidColorBrush x:Key="Win7ControlBorderHotBrush" Color="#3C7FB1"/>
    <SolidColorBrush x:Key="Win7ControlBorderPressedBrush" Color="#2C628B"/>
    <SolidColorBrush x:Key="Win7WindowBorderBrush" Color="#6D8DAA"/>
    <SolidColorBrush x:Key="Win7SeparatorBrush" Color="#D8D8D8"/>
    <SolidColorBrush x:Key="Win7SelectionBorderBrush" Color="#84ACDD"/>
    <SolidColorBrush x:Key="Win7HoverBorderBrush" Color="#B8D6FB"/>
    <SolidColorBrush x:Key="Win7TabBorderBrush" Color="#898C95"/>
    <SolidColorBrush x:Key="Win7SubtlePanelBrush" Color="#F4F4F4"/>

    <LinearGradientBrush x:Key="Win7ButtonNormalBrush" StartPoint="0,0" EndPoint="0,1">
        <GradientStop Color="#FFFFFF" Offset="0"/>
        <GradientStop Color="#F4F4F4" Offset="0.45"/>
        <GradientStop Color="#E4E4E4" Offset="0.52"/>
        <GradientStop Color="#F0F0F0" Offset="1"/>
    </LinearGradientBrush>
    <LinearGradientBrush x:Key="Win7ButtonHoverBrush" StartPoint="0,0" EndPoint="0,1">
        <GradientStop Color="#F7FCFF" Offset="0"/>
        <GradientStop Color="#EAF6FD" Offset="0.48"/>
        <GradientStop Color="#D5EFFC" Offset="0.52"/>
        <GradientStop Color="#E8F7FD" Offset="1"/>
    </LinearGradientBrush>
    <LinearGradientBrush x:Key="Win7ButtonPressedBrush" StartPoint="0,0" EndPoint="0,1">
        <GradientStop Color="#D6EDF8" Offset="0"/>
        <GradientStop Color="#B8DCEE" Offset="0.55"/>
        <GradientStop Color="#D6ECF6" Offset="1"/>
    </LinearGradientBrush>
    <LinearGradientBrush x:Key="Win7DefaultActionBrush" StartPoint="0,0" EndPoint="0,1">
        <GradientStop Color="#F5FBFF" Offset="0"/>
        <GradientStop Color="#E5F3FB" Offset="0.48"/>
        <GradientStop Color="#CEE8F6" Offset="0.52"/>
        <GradientStop Color="#E5F4FB" Offset="1"/>
    </LinearGradientBrush>
    <LinearGradientBrush x:Key="Win7SelectionBrush" StartPoint="0,0" EndPoint="0,1">
        <GradientStop Color="#EAF5FD" Offset="0"/>
        <GradientStop Color="#D3EAF9" Offset="1"/>
    </LinearGradientBrush>
    <LinearGradientBrush x:Key="Win7HoverBrush" StartPoint="0,0" EndPoint="0,1">
        <GradientStop Color="#F5FBFE" Offset="0"/>
        <GradientStop Color="#E3F3FC" Offset="1"/>
    </LinearGradientBrush>
    <LinearGradientBrush x:Key="Win7WindowTitleActiveBrush" StartPoint="0,0" EndPoint="0,1">
        <GradientStop Color="#E9F5FC" Offset="0"/>
        <GradientStop Color="#C5E1F1" Offset="0.48"/>
        <GradientStop Color="#91BDD9" Offset="0.52"/>
        <GradientStop Color="#BCD9EA" Offset="1"/>
    </LinearGradientBrush>
    <LinearGradientBrush x:Key="Win7WindowTitleInactiveBrush" StartPoint="0,0" EndPoint="0,1">
        <GradientStop Color="#F2F4F5" Offset="0"/>
        <GradientStop Color="#DDE3E7" Offset="0.52"/>
        <GradientStop Color="#CBD3D8" Offset="1"/>
    </LinearGradientBrush>

    <Style x:Key="Win7CaptionButton" TargetType="Button">
        <Setter Property="Width" Value="34"/>
        <Setter Property="Height" Value="23"/>
        <Setter Property="Focusable" Value="False"/>
        <Setter Property="Background" Value="#45FFFFFF"/>
        <Setter Property="BorderBrush" Value="#7196B0"/>
        <Setter Property="BorderThickness" Value="1,0,0,1"/>
        <Setter Property="Foreground" Value="#17232D"/>
        <Setter Property="Padding" Value="0"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Border x:Name="CaptionBorder" Background="{TemplateBinding Background}"
                            BorderBrush="{TemplateBinding BorderBrush}"
                            BorderThickness="{TemplateBinding BorderThickness}">
                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="CaptionBorder" Property="Background" Value="#D7EFFB"/>
                            <Setter TargetName="CaptionBorder" Property="BorderBrush" Value="#3C7FB1"/>
                        </Trigger>
                        <Trigger Property="IsPressed" Value="True">
                            <Setter TargetName="CaptionBorder" Property="Background" Value="#9EC9DF"/>
                            <Setter TargetName="CaptionBorder" Property="BorderBrush" Value="#2C628B"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style x:Key="Win7CaptionCloseButton" TargetType="Button" BasedOn="{StaticResource Win7CaptionButton}">
        <Setter Property="Width" Value="43"/>
        <Setter Property="Background" Value="#D46A60"/>
        <Setter Property="BorderBrush" Value="#91483F"/>
        <Setter Property="Foreground" Value="White"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Border x:Name="CaptionBorder" Background="{TemplateBinding Background}"
                            BorderBrush="{TemplateBinding BorderBrush}"
                            BorderThickness="{TemplateBinding BorderThickness}">
                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="CaptionBorder" Property="Background" Value="#E04332"/>
                            <Setter TargetName="CaptionBorder" Property="BorderBrush" Value="#8B1F14"/>
                        </Trigger>
                        <Trigger Property="IsPressed" Value="True">
                            <Setter TargetName="CaptionBorder" Property="Background" Value="#A92C20"/>
                            <Setter TargetName="CaptionBorder" Property="BorderBrush" Value="#64160F"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style TargetType="Window">
        <Setter Property="FontFamily" Value="Segoe UI"/>
        <Setter Property="FontSize" Value="11.5"/>
        <Setter Property="Foreground" Value="{StaticResource TextPrimary}"/>
        <Setter Property="Background" Value="{StaticResource WindowBackground}"/>
        <Setter Property="BorderBrush" Value="{StaticResource Win7WindowBorderBrush}"/>
        <Setter Property="BorderThickness" Value="1"/>
        <Setter Property="WindowStyle" Value="None"/>
        <Setter Property="AllowsTransparency" Value="False"/>
        <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
        <Setter Property="VerticalContentAlignment" Value="Stretch"/>
        <Setter Property="UseLayoutRounding" Value="True"/>
        <Setter Property="TextOptions.TextFormattingMode" Value="Display"/>
        <Setter Property="TextOptions.TextRenderingMode" Value="ClearType"/>
        <Setter Property="shell:WindowChrome.WindowChrome">
            <Setter.Value>
                <shell:WindowChrome CaptionHeight="29" ResizeBorderThickness="5"
                                    CornerRadius="0" GlassFrameThickness="0"
                                    UseAeroCaptionButtons="False"/>
            </Setter.Value>
        </Setter>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Window">
                    <Border x:Name="WindowBorder" Background="{TemplateBinding Background}"
                            BorderBrush="{TemplateBinding BorderBrush}"
                            BorderThickness="{TemplateBinding BorderThickness}"
                            SnapsToDevicePixels="True">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="29"/>
                                <RowDefinition Height="*"/>
                            </Grid.RowDefinitions>

                            <Border x:Name="TitleBar" Grid.Row="0"
                                    Background="{StaticResource Win7WindowTitleActiveBrush}"
                                    BorderBrush="#6E99B6" BorderThickness="0,0,0,1">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <Image Grid.Column="0" Source="{TemplateBinding Icon}" Width="16" Height="16"
                                           Margin="7,0,5,0" VerticalAlignment="Center" SnapsToDevicePixels="True"
                                           RenderOptions.BitmapScalingMode="NearestNeighbor"/>
                                    <TextBlock x:Name="TitleText" Grid.Column="1" Text="{TemplateBinding Title}"
                                               FontSize="11.5" FontWeight="SemiBold" Foreground="#17232D"
                                               VerticalAlignment="Center" TextTrimming="CharacterEllipsis"/>
                                    <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Top"
                                                shell:WindowChrome.IsHitTestVisibleInChrome="True">
                                        <Button x:Name="MinimizeButton" Style="{StaticResource Win7CaptionButton}"
                                                Command="{x:Static win:SystemCommands.MinimizeWindowCommand}"
                                                CommandParameter="{Binding RelativeSource={RelativeSource TemplatedParent}}"
                                                shell:WindowChrome.IsHitTestVisibleInChrome="True"
                                                ToolTip="Свернуть">
                                            <TextBlock Text="0" FontFamily="Marlett" FontSize="10"
                                                       Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType={x:Type Button}}}"/>
                                        </Button>
                                        <Button x:Name="MaximizeButton"
                                                CommandParameter="{Binding RelativeSource={RelativeSource TemplatedParent}}"
                                                shell:WindowChrome.IsHitTestVisibleInChrome="True"
                                                ToolTip="Развернуть/восстановить">
                                            <Button.Style>
                                                <Style TargetType="Button" BasedOn="{StaticResource Win7CaptionButton}">
                                                    <Setter Property="Command" Value="{x:Static win:SystemCommands.MaximizeWindowCommand}"/>
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding WindowState, RelativeSource={RelativeSource AncestorType={x:Type Window}}}"
                                                                     Value="Maximized">
                                                            <Setter Property="Command" Value="{x:Static win:SystemCommands.RestoreWindowCommand}"/>
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </Button.Style>
                                            <Grid Width="10" Height="10">
                                                <TextBlock Text="1" FontFamily="Marlett" FontSize="10"
                                                           Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType={x:Type Button}}}">
                                                    <TextBlock.Style>
                                                        <Style TargetType="TextBlock">
                                                            <Setter Property="Visibility" Value="Visible"/>
                                                            <Style.Triggers>
                                                                <DataTrigger Binding="{Binding WindowState, RelativeSource={RelativeSource AncestorType={x:Type Window}}}"
                                                                             Value="Maximized">
                                                                    <Setter Property="Visibility" Value="Collapsed"/>
                                                                </DataTrigger>
                                                            </Style.Triggers>
                                                        </Style>
                                                    </TextBlock.Style>
                                                </TextBlock>
                                                <TextBlock Text="2" FontFamily="Marlett" FontSize="10"
                                                           Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType={x:Type Button}}}">
                                                    <TextBlock.Style>
                                                        <Style TargetType="TextBlock">
                                                            <Setter Property="Visibility" Value="Collapsed"/>
                                                            <Style.Triggers>
                                                                <DataTrigger Binding="{Binding WindowState, RelativeSource={RelativeSource AncestorType={x:Type Window}}}"
                                                                             Value="Maximized">
                                                                    <Setter Property="Visibility" Value="Visible"/>
                                                                </DataTrigger>
                                                            </Style.Triggers>
                                                        </Style>
                                                    </TextBlock.Style>
                                                </TextBlock>
                                            </Grid>
                                        </Button>
                                        <Button x:Name="CloseButton" Style="{StaticResource Win7CaptionCloseButton}"
                                                Command="{x:Static win:SystemCommands.CloseWindowCommand}"
                                                CommandParameter="{Binding RelativeSource={RelativeSource TemplatedParent}}"
                                                shell:WindowChrome.IsHitTestVisibleInChrome="True"
                                                ToolTip="Закрыть">
                                            <TextBlock Text="r" FontFamily="Marlett" FontSize="10"
                                                       Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType={x:Type Button}}}"/>
                                        </Button>
                                    </StackPanel>
                                </Grid>
                            </Border>

                            <AdornerDecorator Grid.Row="1">
                                <ContentPresenter Content="{TemplateBinding Content}"
                                                  ContentTemplate="{TemplateBinding ContentTemplate}"
                                                  ContentTemplateSelector="{TemplateBinding ContentTemplateSelector}"
                                                  ContentStringFormat="{TemplateBinding ContentStringFormat}"
                                                  HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                                                  VerticalAlignment="{TemplateBinding VerticalContentAlignment}"/>
                            </AdornerDecorator>
                        </Grid>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsActive" Value="False">
                            <Setter TargetName="TitleBar" Property="Background" Value="{StaticResource Win7WindowTitleInactiveBrush}"/>
                            <Setter TargetName="TitleBar" Property="BorderBrush" Value="#A7B1B8"/>
                            <Setter TargetName="TitleText" Property="Foreground" Value="#59636A"/>
                            <Setter TargetName="MinimizeButton" Property="Background" Value="#30FFFFFF"/>
                            <Setter TargetName="MinimizeButton" Property="BorderBrush" Value="#9AA5AB"/>
                            <Setter TargetName="MaximizeButton" Property="Background" Value="#30FFFFFF"/>
                            <Setter TargetName="MaximizeButton" Property="BorderBrush" Value="#9AA5AB"/>
                            <Setter TargetName="CloseButton" Property="Background" Value="#B7B9BA"/>
                            <Setter TargetName="CloseButton" Property="BorderBrush" Value="#8E969B"/>
                            <Setter TargetName="CloseButton" Property="Foreground" Value="#4D555A"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style TargetType="TextBlock">
        <Setter Property="Foreground" Value="{StaticResource TextPrimary}"/>
        <Setter Property="FontFamily" Value="Segoe UI"/>
        <Setter Property="TextOptions.TextFormattingMode" Value="Display"/>
    </Style>

    <Style x:Key="DefaultButton" TargetType="Button">
        <Setter Property="FontFamily" Value="Segoe UI"/>
        <Setter Property="FontSize" Value="11.5"/>
        <Setter Property="Foreground" Value="{StaticResource TextPrimary}"/>
        <Setter Property="Background" Value="{StaticResource Win7ButtonNormalBrush}"/>
        <Setter Property="BorderBrush" Value="{StaticResource Win7ControlBorderBrush}"/>
        <Setter Property="BorderThickness" Value="1"/>
        <Setter Property="Padding" Value="11,5"/>
        <Setter Property="Cursor" Value="Arrow"/>
        <Setter Property="SnapsToDevicePixels" Value="True"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Border x:Name="ButtonBorder" Background="{TemplateBinding Background}"
                            BorderBrush="{TemplateBinding BorderBrush}"
                            BorderThickness="{TemplateBinding BorderThickness}"
                            CornerRadius="2" SnapsToDevicePixels="True">
                        <Border x:Name="InnerHighlight" BorderBrush="#80FFFFFF" BorderThickness="1"
                                CornerRadius="1" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"
                                              RecognizesAccessKey="True"/>
                        </Border>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="ButtonBorder" Property="Background" Value="{StaticResource Win7ButtonHoverBrush}"/>
                            <Setter TargetName="ButtonBorder" Property="BorderBrush" Value="{StaticResource Win7ControlBorderHotBrush}"/>
                        </Trigger>
                        <Trigger Property="IsKeyboardFocused" Value="True">
                            <Setter TargetName="ButtonBorder" Property="BorderBrush" Value="{StaticResource AccentBrush}"/>
                        </Trigger>
                        <Trigger Property="IsPressed" Value="True">
                            <Setter TargetName="ButtonBorder" Property="Background" Value="{StaticResource Win7ButtonPressedBrush}"/>
                            <Setter TargetName="ButtonBorder" Property="BorderBrush" Value="{StaticResource Win7ControlBorderPressedBrush}"/>
                            <Setter TargetName="InnerHighlight" Property="BorderBrush" Value="#40FFFFFF"/>
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter Property="Opacity" Value="0.55"/>
                            <Setter Property="Cursor" Value="Arrow"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style x:Key="PrimaryButton" TargetType="Button" BasedOn="{StaticResource DefaultButton}">
        <Setter Property="Background" Value="{StaticResource Win7DefaultActionBrush}"/>
        <Setter Property="BorderBrush" Value="{StaticResource Win7ControlBorderHotBrush}"/>
        <Setter Property="FontWeight" Value="SemiBold"/>
    </Style>

    <Style x:Key="EditorTextBox" TargetType="TextBox">
        <Setter Property="FontFamily" Value="Segoe UI"/>
        <Setter Property="FontSize" Value="12"/>
        <Setter Property="Foreground" Value="{StaticResource TextPrimary}"/>
        <Setter Property="Background" Value="White"/>
        <Setter Property="BorderBrush" Value="{StaticResource Win7ControlBorderBrush}"/>
        <Setter Property="BorderThickness" Value="1"/>
        <!-- Keep TextBox.Padding out of TextBoxView's text metrics. The classic
             inset is applied exactly once by TextBoxBorder below. -->
        <Setter Property="Padding" Value="0"/>
        <Setter Property="VerticalContentAlignment" Value="Center"/>
        <Setter Property="ScrollViewer.VerticalScrollBarVisibility" Value="Disabled"/>
        <Setter Property="SelectionBrush" Value="#6EA9DD"/>
        <Setter Property="SnapsToDevicePixels" Value="True"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="TextBox">
                    <Border x:Name="TextBoxBorder" Background="{TemplateBinding Background}"
                            BorderBrush="{TemplateBinding BorderBrush}"
                            BorderThickness="{TemplateBinding BorderThickness}"
                            Padding="5,3" SnapsToDevicePixels="True">
                        <ScrollViewer x:Name="PART_ContentHost" Focusable="False"
                                      HorizontalScrollBarVisibility="{TemplateBinding ScrollViewer.HorizontalScrollBarVisibility}"
                                      VerticalScrollBarVisibility="{TemplateBinding ScrollViewer.VerticalScrollBarVisibility}"/>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="TextBoxBorder" Property="BorderBrush" Value="{StaticResource Win7ControlBorderHotBrush}"/>
                        </Trigger>
                        <Trigger Property="IsKeyboardFocused" Value="True">
                            <Setter TargetName="TextBoxBorder" Property="BorderBrush" Value="{StaticResource AccentBrush}"/>
                        </Trigger>
                        <Trigger Property="IsReadOnly" Value="True">
                            <Setter TargetName="TextBoxBorder" Property="Background" Value="#F4F4F4"/>
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter TargetName="TextBoxBorder" Property="Background" Value="#ECECEC"/>
                            <Setter Property="Foreground" Value="#808080"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style x:Key="Win7ComboBoxItemStyle" TargetType="ComboBoxItem">
        <Setter Property="Foreground" Value="{StaticResource TextPrimary}"/>
        <Setter Property="Background" Value="White"/>
        <Setter Property="BorderBrush" Value="Transparent"/>
        <Setter Property="BorderThickness" Value="1"/>
        <Setter Property="Padding" Value="7,3"/>
        <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
        <Setter Property="VerticalContentAlignment" Value="Center"/>
        <Setter Property="SnapsToDevicePixels" Value="True"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ComboBoxItem">
                    <Border x:Name="ItemBorder" Background="{TemplateBinding Background}"
                            BorderBrush="{TemplateBinding BorderBrush}"
                            BorderThickness="{TemplateBinding BorderThickness}"
                            Padding="{TemplateBinding Padding}" SnapsToDevicePixels="True">
                        <ContentPresenter Content="{TemplateBinding Content}"
                                          ContentTemplate="{TemplateBinding ContentTemplate}"
                                          ContentTemplateSelector="{TemplateBinding ContentTemplateSelector}"
                                          ContentStringFormat="{TemplateBinding ContentStringFormat}"
                                          HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                                          VerticalAlignment="{TemplateBinding VerticalContentAlignment}"
                                          RecognizesAccessKey="True"/>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsHighlighted" Value="True">
                            <Setter TargetName="ItemBorder" Property="Background" Value="{StaticResource Win7HoverBrush}"/>
                            <Setter TargetName="ItemBorder" Property="BorderBrush" Value="#B8D6FB"/>
                        </Trigger>
                        <Trigger Property="IsSelected" Value="True">
                            <Setter TargetName="ItemBorder" Property="Background" Value="{StaticResource Win7SelectionBrush}"/>
                            <Setter TargetName="ItemBorder" Property="BorderBrush" Value="#84ACDD"/>
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter Property="Opacity" Value="0.55"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style x:Key="EditorComboBox" TargetType="ComboBox">
        <Setter Property="FontFamily" Value="Segoe UI"/>
        <Setter Property="FontSize" Value="11.5"/>
        <Setter Property="Foreground" Value="{StaticResource TextPrimary}"/>
        <Setter Property="Background" Value="White"/>
        <Setter Property="BorderBrush" Value="{StaticResource Win7ControlBorderBrush}"/>
        <Setter Property="BorderThickness" Value="1"/>
        <Setter Property="Padding" Value="7,3"/>
        <Setter Property="VerticalContentAlignment" Value="Center"/>
        <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
        <Setter Property="MaxDropDownHeight" Value="280"/>
        <Setter Property="ItemContainerStyle" Value="{StaticResource Win7ComboBoxItemStyle}"/>
        <Setter Property="SnapsToDevicePixels" Value="True"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ComboBox">
                    <Grid SnapsToDevicePixels="True">
                        <Border x:Name="ComboBorder" Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="21"/>
                                </Grid.ColumnDefinitions>
                                <ContentPresenter Grid.Column="0" Margin="{TemplateBinding Padding}"
                                                  HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                                                  VerticalAlignment="{TemplateBinding VerticalContentAlignment}"
                                                  Content="{TemplateBinding SelectionBoxItem}"
                                                  ContentTemplate="{TemplateBinding SelectionBoxItemTemplate}"
                                                  ContentTemplateSelector="{TemplateBinding ItemTemplateSelector}"
                                                  ContentStringFormat="{TemplateBinding SelectionBoxItemStringFormat}"
                                                  IsHitTestVisible="False"/>
                                <Border x:Name="ArrowArea" Grid.Column="1"
                                        Background="{StaticResource Win7ButtonNormalBrush}"
                                        BorderBrush="#B0B0B0" BorderThickness="1,0,0,0">
                                    <Path Width="8" Height="4" HorizontalAlignment="Center" VerticalAlignment="Center"
                                          Data="M 0,0 L 4,4 L 8,0 Z" Fill="#333333" Stretch="Fill"/>
                                </Border>
                            </Grid>
                        </Border>
                        <ToggleButton x:Name="DropDownToggle" Background="Transparent" BorderThickness="0"
                                      Focusable="False" ClickMode="Press"
                                      IsChecked="{Binding IsDropDownOpen, Mode=TwoWay, RelativeSource={RelativeSource TemplatedParent}}">
                            <ToggleButton.Template>
                                <ControlTemplate TargetType="ToggleButton">
                                    <Border Background="Transparent"/>
                                </ControlTemplate>
                            </ToggleButton.Template>
                        </ToggleButton>
                        <Popup x:Name="PART_Popup" Placement="Bottom" AllowsTransparency="True"
                               Focusable="False" PopupAnimation="Fade"
                               IsOpen="{TemplateBinding IsDropDownOpen}"
                               PlacementTarget="{Binding RelativeSource={RelativeSource TemplatedParent}}">
                            <Grid MinWidth="{Binding ActualWidth, RelativeSource={RelativeSource TemplatedParent}}"
                                  MaxHeight="{TemplateBinding MaxDropDownHeight}">
                                <Border Background="White" BorderBrush="#7F9DB9" BorderThickness="1">
                                    <ScrollViewer Margin="1" CanContentScroll="True">
                                        <ItemsPresenter KeyboardNavigation.DirectionalNavigation="Contained"/>
                                    </ScrollViewer>
                                </Border>
                            </Grid>
                        </Popup>
                    </Grid>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="ComboBorder" Property="BorderBrush" Value="{StaticResource Win7ControlBorderHotBrush}"/>
                            <Setter TargetName="ArrowArea" Property="Background" Value="{StaticResource Win7ButtonHoverBrush}"/>
                        </Trigger>
                        <Trigger Property="IsKeyboardFocusWithin" Value="True">
                            <Setter TargetName="ComboBorder" Property="BorderBrush" Value="{StaticResource AccentBrush}"/>
                        </Trigger>
                        <Trigger Property="IsDropDownOpen" Value="True">
                            <Setter TargetName="ArrowArea" Property="Background" Value="{StaticResource Win7ButtonPressedBrush}"/>
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter Property="Opacity" Value="0.55"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style TargetType="CheckBox">
        <Setter Property="Foreground" Value="{StaticResource TextPrimary}"/>
        <Setter Property="SnapsToDevicePixels" Value="True"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="CheckBox">
                    <BulletDecorator Background="Transparent">
                        <BulletDecorator.Bullet>
                            <Grid Width="13" Height="13" VerticalAlignment="Center">
                                <Border x:Name="CheckBorder" Background="{StaticResource Win7ButtonNormalBrush}"
                                        BorderBrush="{StaticResource Win7ControlBorderBrush}" BorderThickness="1"/>
                                <Path x:Name="CheckMark" Data="M 2,6 L 5,9 L 11,2" Stroke="#202020"
                                      StrokeThickness="1.6" StrokeLineJoin="Round" Visibility="Collapsed"/>
                                <Rectangle x:Name="IndeterminateMark" Width="6" Height="2" Fill="#202020"
                                           HorizontalAlignment="Center" VerticalAlignment="Center" Visibility="Collapsed"/>
                            </Grid>
                        </BulletDecorator.Bullet>
                        <ContentPresenter Margin="5,0,0,0" VerticalAlignment="Center"
                                          Content="{TemplateBinding Content}"
                                          ContentTemplate="{TemplateBinding ContentTemplate}"
                                          RecognizesAccessKey="True"/>
                    </BulletDecorator>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsChecked" Value="True">
                            <Setter TargetName="CheckMark" Property="Visibility" Value="Visible"/>
                        </Trigger>
                        <Trigger Property="IsChecked" Value="{x:Null}">
                            <Setter TargetName="IndeterminateMark" Property="Visibility" Value="Visible"/>
                        </Trigger>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="CheckBorder" Property="Background" Value="{StaticResource Win7ButtonHoverBrush}"/>
                            <Setter TargetName="CheckBorder" Property="BorderBrush" Value="{StaticResource Win7ControlBorderHotBrush}"/>
                        </Trigger>
                        <Trigger Property="IsPressed" Value="True">
                            <Setter TargetName="CheckBorder" Property="Background" Value="{StaticResource Win7ButtonPressedBrush}"/>
                            <Setter TargetName="CheckBorder" Property="BorderBrush" Value="{StaticResource Win7ControlBorderPressedBrush}"/>
                        </Trigger>
                        <Trigger Property="IsKeyboardFocused" Value="True">
                            <Setter TargetName="CheckBorder" Property="BorderBrush" Value="{StaticResource AccentBrush}"/>
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter Property="Opacity" Value="0.55"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style TargetType="TabControl">
        <Setter Property="Background" Value="{StaticResource SurfaceBrush}"/>
        <Setter Property="BorderBrush" Value="{StaticResource Win7TabBorderBrush}"/>
        <Setter Property="BorderThickness" Value="1"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="TabControl">
                    <Grid KeyboardNavigation.TabNavigation="Local">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="*"/>
                        </Grid.RowDefinitions>
                        <TabPanel x:Name="HeaderPanel" Grid.Row="0" IsItemsHost="True"
                                  KeyboardNavigation.TabIndex="1" Panel.ZIndex="1"/>
                        <Border Grid.Row="1" Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}">
                            <ContentPresenter x:Name="PART_SelectedContentHost" ContentSource="SelectedContent"/>
                        </Border>
                    </Grid>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style TargetType="TabItem">
        <Setter Property="Foreground" Value="{StaticResource TextPrimary}"/>
        <Setter Property="Background" Value="{StaticResource Win7ButtonNormalBrush}"/>
        <Setter Property="BorderBrush" Value="{StaticResource Win7TabBorderBrush}"/>
        <Setter Property="Padding" Value="12,4"/>
        <Setter Property="Margin" Value="0,0,2,-1"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="TabItem">
                    <Border x:Name="HeaderBorder" Background="{TemplateBinding Background}"
                            BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="1"
                            CornerRadius="2,2,0,0" Padding="{TemplateBinding Padding}"
                            Margin="{TemplateBinding Margin}">
                        <ContentPresenter ContentSource="Header" HorizontalAlignment="Center"
                                          VerticalAlignment="Center" RecognizesAccessKey="True"/>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="HeaderBorder" Property="Background" Value="{StaticResource Win7ButtonHoverBrush}"/>
                            <Setter TargetName="HeaderBorder" Property="BorderBrush" Value="{StaticResource Win7ControlBorderHotBrush}"/>
                        </Trigger>
                        <Trigger Property="IsSelected" Value="True">
                            <Setter TargetName="HeaderBorder" Property="Background" Value="{StaticResource SurfaceBrush}"/>
                            <Setter TargetName="HeaderBorder" Property="BorderBrush" Value="{StaticResource Win7TabBorderBrush}"/>
                            <Setter TargetName="HeaderBorder" Property="BorderThickness" Value="1,1,1,0"/>
                            <Setter TargetName="HeaderBorder" Property="Panel.ZIndex" Value="2"/>
                        </Trigger>
                        <Trigger Property="IsKeyboardFocusWithin" Value="True">
                            <Setter TargetName="HeaderBorder" Property="BorderBrush" Value="{StaticResource AccentBrush}"/>
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter Property="Opacity" Value="0.55"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style x:Key="Win7ListBox" TargetType="ListBox">
        <Setter Property="Background" Value="White"/>
        <Setter Property="BorderBrush" Value="{StaticResource Win7ControlBorderBrush}"/>
        <Setter Property="BorderThickness" Value="1"/>
        <Setter Property="SnapsToDevicePixels" Value="True"/>
    </Style>
</ResourceDictionary>
