<Window x:Class="GeniaText.EditorProWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Редактор Pro — GeniaText" Width="940" Height="620"
        MinWidth="820" MinHeight="540" WindowStartupLocation="CenterOwner"
        Background="{StaticResource WindowBackground}"
        Icon="pack://application:,,,/Assets/GeniaText.ico">
    <Grid Margin="18,16,18,14">
        <Grid.RowDefinitions>
            <RowDefinition Height="62"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="46"/>
        </Grid.RowDefinitions>

        <StackPanel Grid.Row="0">
            <TextBlock Text="Редактор Pro" FontSize="20" FontWeight="SemiBold"/>
            <TextBlock Text="Выберите несколько фраз с Ctrl или Shift и примените действие ко всей группе."
                       FontSize="11.5" Margin="0,4,0,0" Foreground="{StaticResource TextSecondary}"/>
        </StackPanel>

        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" MinWidth="430"/>
                <ColumnDefinition Width="16"/>
                <ColumnDefinition Width="310"/>
            </Grid.ColumnDefinitions>

            <Border Grid.Column="0" Background="White" BorderBrush="{StaticResource BorderBrushSoft}"
                    BorderThickness="1" CornerRadius="0" Padding="10">
                <ListBox x:Name="PhraseList" SelectionMode="Extended" Style="{StaticResource Win7ListBox}"
                         SelectionChanged="PhraseList_SelectionChanged"
                         VirtualizingPanel.IsVirtualizing="True"
                         VirtualizingPanel.VirtualizationMode="Recycling"
                         ScrollViewer.CanContentScroll="True">
                    <ListBox.Resources>
                        <Style TargetType="ListBoxItem">
                            <Setter Property="Padding" Value="10,8"/>
                            <Setter Property="Margin" Value="0"/>
                            <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
                            <Setter Property="BorderBrush" Value="{StaticResource Win7SeparatorBrush}"/>
                            <Setter Property="BorderThickness" Value="0,0,0,1"/>
                            <Setter Property="Background" Value="White"/>
                            <Setter Property="Template">
                                <Setter.Value>
                                    <ControlTemplate TargetType="ListBoxItem">
                                        <Border x:Name="B" Background="{TemplateBinding Background}"
                                                BorderBrush="{TemplateBinding BorderBrush}"
                                                BorderThickness="{TemplateBinding BorderThickness}"
                                                Padding="{TemplateBinding Padding}">
                                            <ContentPresenter/>
                                        </Border>
                                        <ControlTemplate.Triggers>
                                            <Trigger Property="IsMouseOver" Value="True">
                                                <Setter TargetName="B" Property="Background" Value="{StaticResource Win7HoverBrush}"/>
                                                <Setter TargetName="B" Property="BorderBrush" Value="{StaticResource Win7HoverBorderBrush}"/>
                                            </Trigger>
                                            <Trigger Property="IsSelected" Value="True">
                                                <Setter TargetName="B" Property="Background" Value="{StaticResource Win7SelectionBrush}"/>
                                                <Setter TargetName="B" Property="BorderBrush" Value="{StaticResource Win7SelectionBorderBrush}"/>
                                            </Trigger>
                                        </ControlTemplate.Triggers>
                                    </ControlTemplate>
                                </Setter.Value>
                            </Setter>
                        </Style>
                    </ListBox.Resources>
                    <ListBox.ItemTemplate>
                        <DataTemplate>
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <TextBlock Text="{Binding DisplayTitle}" FontSize="12"
                                           VerticalAlignment="Center" TextTrimming="CharacterEllipsis"/>
                                <TextBlock Grid.Column="1" Text="{Binding Category}" FontSize="10.5"
                                           MaxWidth="170" Margin="10,0,0,0" VerticalAlignment="Center"
                                           Foreground="{StaticResource TextSecondary}" TextTrimming="CharacterEllipsis"/>
                                <TextBlock Grid.Column="2" Text="★" Foreground="#D97706" FontSize="12"
                                           Margin="8,0,1,0" VerticalAlignment="Center">
                                    <TextBlock.Style>
                                        <Style TargetType="TextBlock">
                                            <Setter Property="Visibility" Value="Collapsed"/>
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding IsFavorite}" Value="True">
                                                    <Setter Property="Visibility" Value="Visible"/>
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </TextBlock.Style>
                                </TextBlock>
                            </Grid>
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                </ListBox>
            </Border>

            <StackPanel Grid.Column="2">
                <Border Background="White" BorderBrush="{StaticResource BorderBrushSoft}"
                        BorderThickness="1" CornerRadius="0" Padding="14" Margin="0,0,0,10">
                    <StackPanel>
                        <TextBlock Text="Пакетные действия" FontSize="13.5" FontWeight="SemiBold"/>
                        <TextBlock x:Name="SelectionSummaryText" Text="Фразы не выбраны" FontSize="11"
                                   Margin="0,5,0,13" Foreground="{StaticResource TextSecondary}"/>
                        <TextBlock Text="Новая категория" FontSize="11" FontWeight="SemiBold"/>
                        <TextBox x:Name="CategoryBox" Style="{StaticResource EditorTextBox}" Margin="0,5,0,8"
                                 MaxLength="256"/>
                        <Button x:Name="ApplyCategoryButton" Style="{StaticResource DefaultButton}"
                                Content="Назначить категорию" Padding="10,5" Click="ApplyCategory_Click"/>
                        <Grid Margin="0,9,0,0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="8"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <Button x:Name="FavoriteButton" Grid.Column="0" Style="{StaticResource DefaultButton}"
                                    Content="★ Добавить" Padding="8,5" Click="AddFavorite_Click"/>
                            <Button x:Name="UnfavoriteButton" Grid.Column="2" Style="{StaticResource DefaultButton}"
                                    Content="Убрать ★" Padding="8,5" Click="RemoveFavorite_Click"/>
                        </Grid>
                        <TextBlock x:Name="ActionStatusText" Margin="0,9,0,0" FontSize="11"
                                   TextWrapping="Wrap" Foreground="{StaticResource TextSecondary}"/>
                    </StackPanel>
                </Border>

                <Border Background="White" BorderBrush="{StaticResource BorderBrushSoft}"
                        BorderThickness="1" CornerRadius="0" Padding="14">
                    <StackPanel>
                        <TextBlock Text="Проверка повторов" FontSize="13.5" FontWeight="SemiBold"/>
                        <TextBlock Text="Сравнивается полный текст без крайних пробелов; переносы строк Windows и Unix считаются одинаковыми. Регистр сохраняется."
                                   Margin="0,5,0,10" FontSize="11" TextWrapping="Wrap"
                                   Foreground="{StaticResource TextSecondary}"/>
                        <Button Style="{StaticResource DefaultButton}" Content="Найти и выделить дубли"
                                Padding="10,5" Click="FindDuplicates_Click"/>
                        <TextBlock x:Name="DuplicateSummaryText" Margin="0,9,0,0" FontSize="11"
                                   TextWrapping="Wrap" Foreground="{StaticResource TextSecondary}"/>
                    </StackPanel>
                </Border>
            </StackPanel>
        </Grid>

        <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Bottom">
            <Button Style="{StaticResource PrimaryButton}" Content="Готово" MinWidth="94"
                    Padding="12,5" Click="Close_Click"/>
        </StackPanel>
    </Grid>
</Window>
