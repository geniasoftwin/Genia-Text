<Window x:Class="GeniaText.PhraseEditorWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Управление фразами — GeniaText" Width="1060" Height="650"
        MinWidth="940" MinHeight="540" WindowStartupLocation="CenterScreen"
        Background="{StaticResource WindowBackground}"
        Icon="pack://application:,,,/Assets/GeniaText.ico">
    <Grid Margin="16,16,16,14">
        <Grid.RowDefinitions>
            <RowDefinition Height="74"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="46"/>
        </Grid.RowDefinitions>

        <Grid Grid.Row="0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>
            <StackPanel VerticalAlignment="Top">
                <TextBlock Text="Управление фразами" FontSize="21" FontWeight="SemiBold"/>
                <TextBlock Text="Редактирование, импорт, экспорт, восстановление и настройки." FontSize="11.5" Margin="0,4,0,0"
                           Foreground="{StaticResource TextSecondary}"/>
            </StackPanel>
            <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Top">
                <Button x:Name="EditorProButton" Style="{StaticResource PrimaryButton}" Content="Редактор Pro"
                        MinWidth="106" Padding="12,5" Margin="0,0,7,0" Visibility="Collapsed"
                        Click="EditorPro_Click"/>
                <Button x:Name="RecycleBinButton" Style="{StaticResource DefaultButton}" Content="Корзина"
                        MinWidth="82" Padding="12,5" Margin="0,0,7,0" Visibility="Collapsed"
                        ToolTipService.ShowOnDisabled="True"
                        Click="RecycleBin_Click"/>
                <Button x:Name="BackupBrowserButton" Style="{StaticResource DefaultButton}" Content="Резервные копии"
                        MinWidth="124" Padding="12,5" Margin="0,0,7,0" Visibility="Collapsed"
                        Click="BackupBrowser_Click"/>
                <Button Style="{StaticResource DefaultButton}" Content="Импорт" ClickMode="Press" MinWidth="74" Padding="12,5" Margin="0,0,7,0" Click="Import_Click"/>
                <Button Style="{StaticResource DefaultButton}" Content="Экспорт" ClickMode="Press" MinWidth="78" Padding="12,5" Margin="0,0,7,0" Click="Export_Click"/>
                <Button Style="{StaticResource DefaultButton}" Content="Настройки" ClickMode="Press" MinWidth="88" Padding="12,5" Click="Settings_Click"/>
            </StackPanel>
        </Grid>

        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="380" MinWidth="370"/>
                <ColumnDefinition Width="14"/>
                <ColumnDefinition Width="*" MinWidth="390"/>
            </Grid.ColumnDefinitions>

            <Border Grid.Column="0" Background="White" BorderBrush="{StaticResource BorderBrushSoft}"
                    BorderThickness="1" CornerRadius="0" Padding="12">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="27"/>
                        <RowDefinition Height="34"/>
                        <RowDefinition Height="8"/>
                        <RowDefinition Height="34"/>
                    </Grid.RowDefinitions>
                    <ListBox x:Name="PhrasesList" Grid.Row="0" Style="{StaticResource Win7ListBox}"
                             VirtualizingPanel.IsVirtualizing="True" VirtualizingPanel.VirtualizationMode="Recycling"
                             ScrollViewer.CanContentScroll="True"
                             SelectionChanged="PhrasesList_SelectionChanged"
                             PreviewMouseLeftButtonDown="PhrasesList_PreviewMouseLeftButtonDown"
                             MouseMove="PhrasesList_MouseMove" DragOver="PhrasesList_DragOver" Drop="PhrasesList_Drop"
                             AllowDrop="True" ScrollViewer.HorizontalScrollBarVisibility="Auto">
                        <ListBox.Resources>
                            <Style TargetType="ListBoxItem">
                                <Setter Property="Padding" Value="10,8"/>
                                <Setter Property="Margin" Value="0"/>
                                <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
                                <Setter Property="BorderBrush" Value="{StaticResource Win7SeparatorBrush}"/>
                                <Setter Property="BorderThickness" Value="0,0,0,1"/>
                                <Setter Property="Background" Value="White"/>
                                <Setter Property="Template">
                                    <Setter.Value>
                                        <ControlTemplate TargetType="ListBoxItem">
                                            <Border x:Name="B" Background="{TemplateBinding Background}"
                                                    BorderBrush="{TemplateBinding BorderBrush}"
                                                    BorderThickness="{TemplateBinding BorderThickness}"
                                                    Padding="{TemplateBinding Padding}">
                                                <ContentPresenter/>
                                            </Border>
                                            <ControlTemplate.Triggers>
                                                <Trigger Property="IsMouseOver" Value="True">
                                                    <Setter TargetName="B" Property="Background" Value="{StaticResource Win7HoverBrush}"/>
                                                    <Setter TargetName="B" Property="BorderBrush" Value="{StaticResource Win7HoverBorderBrush}"/>
                                                </Trigger>
                                                <Trigger Property="IsSelected" Value="True">
                                                    <Setter TargetName="B" Property="Background" Value="{StaticResource Win7SelectionBrush}"/>
                                                    <Setter TargetName="B" Property="BorderBrush" Value="{StaticResource Win7SelectionBorderBrush}"/>
                                                </Trigger>
                                            </ControlTemplate.Triggers>
                                        </ControlTemplate>
                                    </Setter.Value>
                                </Setter>
                            </Style>
                        </ListBox.Resources>
                        <ListBox.ItemTemplate>
                            <DataTemplate>
                                <TextBlock Text="{Binding DisplayTitle}" FontSize="12" TextTrimming="CharacterEllipsis"
                                           MinWidth="230"/>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>
                    <TextBlock Grid.Row="1" Text="Перетащите фразу или используйте кнопки ниже" FontSize="11"
                               Foreground="{StaticResource TextSecondary}" VerticalAlignment="Center"/>
                    <Grid Grid.Row="2">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/><ColumnDefinition Width="7"/>
                            <ColumnDefinition Width="*"/><ColumnDefinition Width="7"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <Button Grid.Column="0" Style="{StaticResource DefaultButton}" Content="Добавить" MinWidth="76" Padding="9,4" Click="Add_Click"/>
                        <Button Grid.Column="2" Style="{StaticResource DefaultButton}" Content="Копия" MinWidth="68" Padding="9,4" Click="Duplicate_Click"/>
                        <Button Grid.Column="4" Style="{StaticResource DefaultButton}" Content="Удалить" MinWidth="76" Padding="9,4" Click="Delete_Click"/>
                    </Grid>
                    <Grid Grid.Row="4">
                        <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="7"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                        <Button x:Name="MoveUpButton" Grid.Column="0" Style="{StaticResource DefaultButton}" Content="↑ Выше" MinWidth="84" Padding="9,4" Click="MoveUp_Click"/>
                        <Button x:Name="MoveDownButton" Grid.Column="2" Style="{StaticResource DefaultButton}" Content="↓ Ниже" MinWidth="84" Padding="9,4" Click="MoveDown_Click"/>
                    </Grid>
                </Grid>
            </Border>

            <Border Grid.Column="2" Background="White" BorderBrush="{StaticResource BorderBrushSoft}"
                    BorderThickness="1" CornerRadius="0" Padding="16">
                <Grid x:Name="EditorPanel" DataContext="{Binding ElementName=PhrasesList, Path=SelectedItem}">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="19"/><RowDefinition Height="32"/><RowDefinition Height="13"/>
                        <RowDefinition Height="19"/><RowDefinition Height="32"/><RowDefinition Height="13"/>
                        <RowDefinition Height="19"/><RowDefinition Height="*"/>
                    </Grid.RowDefinitions>
                    <TextBlock Grid.Row="0" Text="Название (необязательно)" FontSize="11.5" FontWeight="SemiBold"/>
                    <TextBox x:Name="TitleBox" Grid.Row="1" Style="{StaticResource EditorTextBox}"
                             Text="{Binding Title, UpdateSourceTrigger=LostFocus}"/>
                    <TextBlock Grid.Row="3" Text="Категория (необязательно)" FontSize="11.5" FontWeight="SemiBold"/>
                    <Grid Grid.Row="4">
                        <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="14"/><ColumnDefinition Width="110"/></Grid.ColumnDefinitions>
                        <TextBox x:Name="CategoryBox" Grid.Column="0" Style="{StaticResource EditorTextBox}"
                                 Text="{Binding Category, UpdateSourceTrigger=LostFocus}"/>
                        <CheckBox Grid.Column="2" Content="★ Избранное" VerticalAlignment="Center" IsChecked="{Binding IsFavorite, UpdateSourceTrigger=PropertyChanged}"/>
                    </Grid>
                    <TextBlock Grid.Row="6" Text="Текст фразы" FontSize="11.5" FontWeight="SemiBold"/>
                    <TextBox Grid.Row="7" Style="{StaticResource EditorTextBox}" Text="{Binding Text, UpdateSourceTrigger=PropertyChanged}"
                             AcceptsReturn="True" AcceptsTab="True" TextWrapping="Wrap" VerticalContentAlignment="Top"
                             VerticalScrollBarVisibility="Auto"/>
                </Grid>
            </Border>
        </Grid>

        <Grid Grid.Row="2" VerticalAlignment="Bottom">
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                <Button Style="{StaticResource DefaultButton}" Content="Закрыть" MinWidth="86" Padding="12,5" Margin="0,0,7,0" Click="Close_Click"/>
                <Button Style="{StaticResource PrimaryButton}" Content="Сохранить" MinWidth="98" Padding="12,5" Click="Save_Click"/>
            </StackPanel>
        </Grid>
    </Grid>
</Window>
